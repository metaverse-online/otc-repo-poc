# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value is read from the environment at startup.
# ---------------------------------------------------------------------------

# --- core ---------------------------------------------------------------
# Generate a unique value for each environment:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
OTC_BRAND=OTC Desk
OTC_ENV_NAME=POC

# Optional. Defaults to <OTC_DATA_DIR>/otc.sqlite3 (i.e. ./var/otc.sqlite3).
# PostgreSQL works too, once the driver is installed:
#   DATABASE_URL=postgresql+psycopg://otc:change-me@127.0.0.1:5432/otc

# --- product rules ------------------------------------------------------
FEE_BPS=60

# --- on-chain verification ---------------------------------------------
# true  = deterministic simulator (no network, everything flagged "simulated")
# false = real providers below
CHAIN_DEMO=true
BLOCKSTREAM_URL=https://blockstream.info/api
ETHERSCAN_API_KEY=
TRON_API_KEY=

# --- cookies ------------------------------------------------------------
# Set to true once served over HTTPS
SESSION_COOKIE_SECURE=false
