# Reverse proxy example for the OTC Desk POC.
# Install as /etc/nginx/sites-available/otc-desk and symlink into sites-enabled.
# Replace desk.example.com and the certificate paths before enabling.

server {
    listen 80;
    server_name desk.example.com;

    # Keep this once TLS is enabled (certbot fills it in automatically):
    # return 301 https://$host$request_uri;

    client_max_body_size 5m;          # receipt uploads are capped at 4 MB

    location / {
        proxy_pass http://127.0.0.1:5055;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 65s;
    }
}

