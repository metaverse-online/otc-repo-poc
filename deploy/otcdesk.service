[Unit]
Description=OTC Desk POC (Flask + gunicorn)
After=network.target

[Service]
Type=simple
User=otcdesk
Group=otcdesk
WorkingDirectory=/opt/otc-desk
EnvironmentFile=/opt/otc-desk/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/otc-desk/.venv/bin/gunicorn --workers 1 --threads 4 --timeout 60 --bind 0.0.0.0:5055 --access-logfile - --error-logfile - wsgi:app
Restart=always
RestartSec=3

# Basic hardening: no privilege escalation, private /tmp, read-only system dirs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
